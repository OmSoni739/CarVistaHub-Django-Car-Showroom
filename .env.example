# ==============================================================================
# CarVistaHub - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and populate with your local/deployment settings.
# NEVER commit your actual '.env' file containing real secrets to version control.
# ==============================================================================

# Django Secret Key (Generate a unique 50+ character secret key for production)
SECRET_KEY=replace_with_your_django_secret_key

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated list of hostnames/IPs)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Engine Selection
# Set USE_SQLITE=True to use local SQLite development database (db.sqlite3)
# Set USE_SQLITE=False to connect to MySQL database using the credentials below
USE_SQLITE=True

# MySQL Database Configuration (Required if USE_SQLITE=False)
DB_ENGINE=django.db.backends.mysql
DB_NAME=autohub_db
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Razorpay Payment Gateway Test/Live Credentials
# Obtain API Keys from your Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=your_test_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# Security Settings (Optional overrides for HTTPS production environments)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
